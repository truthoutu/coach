# ─── Tawk.to live chat (public embed identifiers) ─────────────────────────────
# The OFFICIAL owner-supplied credentials are already baked into
# src/components/layout/FloatingChat.tsx as the built-in default:
#   NEXT_PUBLIC_TAWK_PROPERTY_ID=6aa17322094d073447a182b4
#   NEXT_PUBLIC_TAWK_WIDGET_ID=1k23ajhur
# Find them in the Tawk.to dashboard: Administration → Channels → Chat Widget.
# Under "Direct Chat Link" the URL is https://tawk.to/chat/<PROPERTY_ID>/<WIDGET_ID>
#
# These values are PUBLIC embed identifiers (they are part of the official
# embed script served to every visitor) and are safe in the browser bundle.
# The vars below are OPTIONAL overrides only (e.g. a staging widget).
# NEVER put secret API/signing keys here.
NEXT_PUBLIC_TAWK_PROPERTY_ID=6aa17322094d073447a182b4
NEXT_PUBLIC_TAWK_WIDGET_ID=1k23ajhur
